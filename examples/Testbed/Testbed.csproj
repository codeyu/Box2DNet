<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- converted code: nullable annotations only, like the library -->
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- the ImGui and GLFW bindings use pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Box2DNet.Testbed</RootNamespace>
    <!-- the samples are converted from C++ and keep its shape -->
    <NoWarn>$(NoWarn);CS9191;CS0219;CS0168;CS0414;CS0649;CS0169;CS0162</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageReference Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
    <PackageReference Include="Hexa.NET.ImGui.Backends.GLFW" Version="1.0.18" />
    <PackageReference Include="Hexa.NET.GLFW" Version="1.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Box2DNet\Box2DNet.csproj" />
    <ProjectReference Include="..\..\shared\Box2DNet.Shared\Box2DNet.Shared.csproj" />
  </ItemGroup>

</Project>
